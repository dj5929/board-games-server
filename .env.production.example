# Copy to the VPS as `/opt/board-game-server/.env` (or your `DEPLOY_DIR`) during
# bootstrapping. This file lives ONLY on the server — never commit real secrets to git.
#
# The deploy workflow reads it at deploy time and passes it to docker-compose,
# overriding the defaults in docker-compose.yml. Just set the values below.

# --- Required: point the client and CORS at your real domain(s) ---

# Origin(s) that the browser serves the client from. Comma-separated allow-list.
# This becomes the server's CORS allow-list. Include HTTPS and any subdomains.
CLIENT_ORIGIN=https://games.example.com

# Full backend API base URL baked into the client bundle. Must be reachable from
# the browser. If you terminate TLS at a reverse proxy in front of :3000, use the
# public proxy URL (e.g. https://api.example.com); otherwise the server's public :3000.
CLIENT_API_URL=https://api.example.com

# --- Optional ---

# Auto-forfeit / AFK timeout in ms. 0 = disabled (default).
#TURN_TIME_LIMIT_MS=120000
